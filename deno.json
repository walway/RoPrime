{
  "nodeModulesDir": "none",
  "lock": true,
  "tasks": {
    "fmt": "deno fmt --check",
    "lint": "deno lint",
    "build": "deno task fmt && deno task lint; deno run -A tasks/build.js"
  },
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.118.0",
    "gulp": "npm:gulp@^5.0.1",
    "minify-all": "npm:minify-all@^1.2.2",
    "prism-code-editor/setups": "npm:prism-code-editor@5.4.0/setups",
    "prism-code-editor/languages/css": "npm:prism-code-editor@5.4.0/languages/css",
    "prism-code-editor/prism/languages/css": "npm:prism-code-editor@5.4.0/prism/languages/css",
    "roavatar-renderer": "npm:roavatar-renderer@^1.9.11",
    "force-graph": "npm:force-graph@1.52.0",
    "esbuild": "npm:esbuild@0.28.2",
    "adm-zip": "npm:adm-zip@0.6.1",
    "dotenv": "npm:dotenv@18.0.8",
    "dompurify": "npm:dompurify@3.4.17",
    "web-ext": "npm:web-ext@^10.8.0"
  },
  "lint": {
    "include": [
      "src",
      "tasks",
      "configs",
      "scripts",
      "_locales"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "eqeqeq",
        "explicit-function-return-type",
        "verbatim-module-syntax",
        "single-var-declarator",
        "no-eval",
        "no-sparse-arrays",
        "no-inferrable-types",
        "no-external-import",
        "no-const-assign",
        "default-param-last"
      ] 
    }
},
  "fmt": {
    "indentWidth": 4,
      "lineWidth": 120,
      "useTabs": false,
      "semiColons": false,
      "singleQuote": true,
      "include": [
          "src",
          "tasks",
          "configs",
          "scripts",
          "_locales"
    ],
      "exclude": [ "dist", "node_modules", "resources", "**/overview.md" ]
    },
  "exclude": ["dist", "node_modules"]
}
