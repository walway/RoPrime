{
	"manifest_version": 3,
	"name": "RoPrime - New Era of Roblox website",
	"version": "1.5.0",
	"description": "RoPrime adds useful design-focused features and more.",
	"permissions": ["storage"],
	"host_permissions": [
		"*://*.supabase.co/*",
		"https://users.roblox.com/*",
		"https://thumbnails.roblox.com/*",
		"https://walway.github.io/*"
	],
	"optional_permissions": ["management"],
	"background": {
		"service_worker": "src/content/background.js"
	},
	"action": {
		"default_title": "RoPrime"
	},
	"icons": {
		"16": "resources/icons/icon16.png",
		"32": "resources/icons/icon32.png",
		"48": "resources/icons/icon48.png",
		"64": "resources/icons/icon64.png",
		"128": "resources/icons/icon128.png"
	},
	"web_accessible_resources": [
		{
			"resources": [
				"resources/roprime-icon.png",
				"resources/RblxPlusLogo.webp",
				"resources/logo.svg",
				"src/strings/**/*",
				"resources/data/*"
			],
			"matches": ["*://*.roblox.com/*"]
		}
	],
	"content_scripts": [
		{
			"matches": ["*://*.roblox.com/*"],
			"js": ["content.js"],
			"css": ["src/style/*.css"],
			"run_at": "document_start"
		}
	]
}
