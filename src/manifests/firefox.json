{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "version": "1.6.0",
    "default_locale": "en",
    "description": "__MSG_extDescription__",
    "browser_specific_settings": {
        "gecko": {
            "id": "jokepreston@gmail.com",
            "strict_min_version": "109.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        },
        "gecko_android": {
            "strict_min_version": "120.0"
        }
    },
    "permissions": [
        "storage",
        "management",
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "*://*.roblox.com/*",
        "*://*.rbxcdn.com/*",
        "https://js.rbxcdn.com/*",
        "https://raw.githubusercontent.com/*",
        "https://chromewebstore.googleapis.com/*",
        "https://lh3.googleusercontent.com/*",
        "https://*.roproxy.com/*",
        "https://*.rotunnel.com/*",
        "https://*.supabase.co/*"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "action": {
        "default_title": "__MSG_extActionTitle__"
    },
    "icons": {
        "16": "resources/icons/icon16.png",
        "32": "resources/icons/icon32.png",
        "48": "resources/icons/icon48.png",
        "64": "resources/icons/icon64.png",
        "128": "resources/icons/icon128.png"
    },
    "declarative_net_request": {
        "rule_resources": [{
            "id": "navigation_override_rules",
            "enabled": false,
            "path": "src/rules/Navigation/block.json"
        }]
    },
    "web_accessible_resources": [
        {
            "resources": [
                "resources/vendor/draco_decoder.js",
                "resources/vendor/material-symbols-outlined.ttf",
                "resources/vendor/Navigation.js",
                "avatar-preview.js",
                "resources/roprime-icon.png",
                "resources/Verity.webp",
                "resources/RblxPlusLogo.webp",
                "resources/logo.svg",
                "resources/EventLogo2024.svg",
                "resources/icons/*",
                "_locales/**/*",
                "src/strings/**/*",
                "resources/data/*",
                "resources/badges/*"
            ],
            "matches": [
                "*://*.roblox.com/*",
                "*://roblox.com/*"
            ]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.roblox.com/*",
                "*://roblox.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "src/style/index.css"
            ],
            "run_at": "document_start"
        }
    ]
}
