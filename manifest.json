{
	"manifest_version": 3,
	"name": "RoPrime - Making Roblox feel better",
	"version": "1.3.0",
	"description": "The new era of Roblox website.",
	"permissions": ["storage"],
	"optional_permissions": ["management"],
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_title": "RoPrime"
	},
	"icons": {
		"16": "resources/icons/icon16.png",
		"32": "resources/icons/icon32.png",
		"48": "resources/icons/icon48.png",
		"64": "resources/icons/icon64.png",
		"128": "resources/icons/icon128.png"
	},
	"web_accessible_resources": [
		{
			"resources": [
				"resources/roprime-icon.png",
				"resources/RblxPlusLogo.webp",
				"resources/logo.svg",
				"src/style/**/*.css",
				".locales/*",
				".locales/lang-config.js",
				"resources/data/*"
			],
			"matches": ["*://*.roblox.com/*"]
		}
	],
	"content_scripts": [
		{
			"matches": ["*://*.roblox.com/*"],
			"js": ["dist/content.js"],
			"css": ["src/style/index.css"],
			"run_at": "document_start"
		}
	]
}
